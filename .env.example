# Copy to .env and replace the keys before enabling either service.
# .env is ignored by Git. Values here use shell assignment syntax.
JEV_ENABLED=false
JEV_API_KEY=
AI_ENABLED=false
# Spring AI uses its OpenAI-compatible adapter for both OpenAI and DeepSeek.
SPRING_AI_CHAT_MODEL=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-5-mini
